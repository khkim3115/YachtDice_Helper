{
  "name": "yacht-dice-desktop",
  "version": "0.10.0",
  "private": true,
  "description": "Yacht Dice 트레이 앱",
  "main": "main.js",
  "scripts": {
    "build:engine": "node scripts/build-engine.cjs",
    "prestart": "npm run build:engine",
    "start": "electron .",
    "predist": "npm run build:engine",
    "dist": "electron-builder",
    "test:helper": "npm run build:engine && electron scripts/test-helper.cjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.khkim.yachtdice",
    "productName": "Yacht Dice",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "popup.html",
      "vendor/supabase.js",
      "vendor/yd-engine.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../public",
        "to": "public",
        "filter": ["V.bin", "V.additional.bin"]
      }
    ],
    "afterPack": "scripts/adhoc-sign.cjs",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "darkModeSupport": true
    },
    "dmg": {
      "artifactName": "YachtDice-Tray.dmg",
      "title": "Yacht Dice"
    },
    "nsis": {
      "artifactName": "YachtDice-Tray-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Yacht Dice"
    },
    "publish": {
      "provider": "github",
      "owner": "khkim3115",
      "repo": "YachtDice_Helper"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
